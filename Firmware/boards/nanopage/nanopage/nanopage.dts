/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Pin assignments below come from the module pinout table in the
 * project README (E73-2G4M08S1C, U8 in the schematic). Signals that
 * belong to a driver which hasn't been added yet (fuel gauge, SD card
 * detect, charger/USB status lines) are left unwired here on purpose -
 * see the comment block at the bottom.
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "nanopage-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "NanoPage E-Reader";
	compatible = "nanopage,nanopage";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,settings-partition = &settings_partition;
		zephyr,display = &epd_panel;
	};

	buttons_input: buttons {
		compatible = "gpio-keys";

		/* P0.09/NFC1 - needs &uicr nfct-pins-as-gpios below to read as GPIO */
		button_action: button_action {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};

		/* P0.10/NFC2 - needs &uicr nfct-pins-as-gpios below to read as GPIO */
		button_next: button_next {
			gpios = <&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		button_prev: button_prev {
			gpios = <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_LEFT>;
		};
	};

	/*
	 * Long-press detection for the Action button only, via Zephyr's
	 * in-tree zephyr,input-longpress pseudo-device (subsys/input/
	 * input_longpress.c) - reused instead of hand-rolled hold-timing
	 * logic in buttons.c. Watches buttons_input for INPUT_KEY_ENTER and,
	 * on release, re-emits either the same code (short press, < 500ms -
	 * this is what buttons.c now treats as the real "Action" press
	 * everywhere, not the raw buttons_input event, so every screen's
	 * Action handling now fires on release rather than on press - see
	 * buttons.c) or INPUT_KEY_MENU (held >= 500ms), which reader.c uses
	 * to open the in-book menu (Table of Contents/Bookmarks) - see
	 * reader_menu.h. Prev/Next are not wrapped by this node so paging
	 * stays instant; see nav_longpress below. CONFIG_INPUT_LONGPRESS is enabled automatically
	 * (default y, gated on this node existing - see subsys/input/Kconfig).
	 */
	action_longpress: longpress {
		compatible = "zephyr,input-longpress";
		input = <&buttons_input>;
		input-codes = <INPUT_KEY_ENTER>;
		short-codes = <INPUT_KEY_ENTER>;
		long-codes = <INPUT_KEY_MENU>;
		long-delay-ms = <500>;
	};

	/*
	 * Prev/Next hold detection. Only matters while a screen registers a
	 * hold callback (app_buttons_set_hold_callback); buttons.c ignores
	 * this node's events otherwise, so Prev/Next stay instant on the raw
	 * buttons_input event. PAGEUP = hold Prev, PAGEDOWN = hold Next.
	 */
	nav_longpress: longpress-nav {
		compatible = "zephyr,input-longpress";
		input = <&buttons_input>;
		input-codes = <INPUT_KEY_LEFT INPUT_KEY_RIGHT>;
		short-codes = <INPUT_KEY_LEFT INPUT_KEY_RIGHT>;
		long-codes = <INPUT_KEY_PAGEUP INPUT_KEY_PAGEDOWN>;
		long-delay-ms = <500>;
	};

	/* microSD load switch enable, P1.11 */
	regulator_sdhc: regulator-sdhc-pwr {
		compatible = "regulator-fixed";
		regulator-name = "sdhc-pwr";
		enable-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	/*
	 * GDEY029T94 e-paper panel (128x296, SSD1680 controller) on spi3,
	 * CS index 0 there (see cs-gpios on &spi3 below). Zephyr's in-tree
	 * SSD16XX driver talks to it over the generic MIPI DBI Mode C
	 * (4-wire SPI) bridge, so the actual SPI bus is wrapped in a
	 * zephyr,mipi-dbi-spi node that owns the DC/reset lines; reg = <0>
	 * on the panel node below selects cs-gpios[0] on spi3 through
	 * that wrapper.
	 */
	display_mipi: display-mipi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi3>;
		dc-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;		/* P0.06 */
		reset-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;	/* P0.05 */
		#address-cells = <1>;
		#size-cells = <0>;

		epd_panel: ssd1680@0 {
			compatible = "solomon,ssd1680";
			reg = <0>;
			mipi-max-frequency = <4000000>;
			/*
			 * In this driver "width" is the gate-line count
			 * (SSD1680 max 296) and "height" is the source-line
			 * count (max 176) - not screen columns/rows. Panel
			 * is 296(H, gate) x 128(V, source) per the GDEY029T94
			 * datasheet.
			 */
			width = <296>;
			height = <128>;
			/*
			 * 180 degrees so the panel reads right-side up for how
			 * the device is actually held - the natural mounting
			 * orientation is upside down relative to the driver's
			 * default. ROTATED_180 stays on the same code path as
			 * NORMAL in ssd16xx.c (x/y resolution and the vtiled
			 * buffer layout are unchanged, just the RAM scan
			 * direction flips) - unlike 90/270, which would swap
			 * width/height and drop the vtiled layout text.c
			 * depends on.
			 */
			rotation = <180>;
			busy-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;	/* P0.08 */

			/*
			 * Enables the SSD1680's faster/partial ("Mode 2")
			 * waveform. Empty on purpose: this chip's OTP
			 * already stores both the full and Mode 2 waveforms,
			 * selected purely via an UPDATE_CTRL2 register bit
			 * (see quirks_solomon_ssd1680.ctrl2_partial in
			 * ssd16xx.c) - no custom LUT bytes needed. Presence
			 * of this node is what the driver checks, per its
			 * SSD16XX_DEFINE()/DT_CHILD(n, partial) macro.
			 */
			partial {
			};
		};
	};

	aliases {
		sw-action = &button_action;
		sw-next = &button_next;
		sw-prev = &button_prev;
		rtc0 = &rtc_ext;
	};

	/*
	 * BQ25170 STAT output, P0.03 - open-drain, pulled up externally
	 * (R8, 10k to +3V3 per the schematic), so no internal pull is
	 * configured here. No dedicated driver/binding for this - a plain
	 * zephyr,user property is the standard way to hand app code a raw
	 * GPIO it configures/reads itself (see charger.c).
	 */
	zephyr,user {
		charger-status-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
	};
};

/* Externally regulated 3.3V feeds both VDD and VDDH - REG0 (VDDH->VDD
 * boost path) isn't in the power path, so it's left disabled (SoC
 * default). REG1 in DC/DC mode is the standard efficiency win.
 *
 * Tested LDO vs DCDC directly (2026-09-11) while chasing an unexplained
 * ~1-3mA idle current shown by the fuel gauge: no measurable difference
 * either way, so DCDC is not implicated and stays on for its real
 * benefit during active/refresh periods. See project memory for the
 * full current-draw investigation and what's still open.
 */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&uicr {
	/* No NFC antenna on this board - P0.09/P0.10 are Action/Next buttons */
	nfct-pins-as-gpios;
	/* P0.18 is the dedicated reset button pin */
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/*
 * Native USB device peripheral - VBUS/D+/D- are wired directly to it (see
 * the README pinout table), used by usb_msc.c for the USB Mass Storage
 * file-browser feature. zephyr_udc0 is the node label Zephyr's USB device
 * stack looks up by name (DT_NODELABEL(zephyr_udc0)), same convention
 * every in-tree nRF52840 board uses (e.g. nrf52840dk_nrf52840.dts).
 */
zephyr_udc0: &usbd {
	status = "okay";
};

/* RTC (PCF85063) + fuel gauge (MAX17055) */
&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	/*
	 * PCF85063 RTC, fixed I2C address 0x51. Zephyr's in-tree
	 * nxp,pcf85063a binding/driver is used as-is (same register
	 * map as the plain PCF85063 on this board).
	 */
	rtc_ext: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
		int1-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
	};

	/*
	 * MAX17055, fixed I2C address 0x36. compatible = "nanopage,max17055"
	 * (own from-scratch driver, src/max17055.c) rather than upstream's
	 * "maxim,max17055" - see the top-of-file comment there for why.
	 * rsense-mohms/i-chg-term come from the schematic (R11 = 10m sense
	 * resistor; R7 = 1k on ISET -> 300mA per the BQ25170's printed
	 * I_CHG = 300AOhms/R_ISET formula, i-chg-term uses the conventional
	 * C/10 termination current). design-voltage/desired-voltage = 4200mV
	 * matches the charger's VSET resistor (R6 = 27k -> 4.20V per the
	 * schematic's printed VSET table). v-empty/v-recover = 3300mV/3880mV
	 * matches the guide's own worked example (Section "MAX17055 INI File
	 * Format", VEmpty = 0xa561 decodes to exactly these two values).
	 */
	fuel_gauge_ext: fuel-gauge@36 {
		compatible = "nanopage,max17055";
		reg = <0x36>;
		rsense-mohms = <10>;
		design-capacity = <320>;
		design-voltage = <4200>;
		desired-voltage = <4200>;
		desired-charging-current = <300>;
		i-chg-term = <32>;
		v-empty = <3300>;
		v-recover = <3880>;
	};
};

/* E-paper panel (SSD1680) + microSD card, own CS line each */
&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>,	/* display CS, P0.26 */
		   <&gpio1 9 GPIO_ACTIVE_LOW>;		/* SD card CS, P1.09 */
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	/*
	 * microSD card, SD-over-SPI (zephyr,sdhc-spi-slot -> the SD
	 * subsystem -> zephyr,sdmmc-disk for the disk_access/fs_mount
	 * API), reg = <1> selects cs-gpios[1] above (P1.09). The card's
	 * own load switch (regulator_sdhc, P1.11) is a separate
	 * regulator-fixed node, not this binding's pwr-gpios - sd.c
	 * enables/times it explicitly rather than letting this driver
	 * toggle it around every init, per the app-level sequencing this
	 * board's known power/display interaction needs (see sd.c).
	 * Raised from the original 4MHz first-bring-up value to 16MHz
	 * 2026-09-18, chasing a USB Mass Storage (usb_msc.c) directory
	 * listing that was still very slow to enumerate on a real host even
	 * after fixing the spi3 PM refcounting bug (display.c) and batching
	 * MSC's own reads (CONFIG_USBD_MSC_SCSI_BUFFER_SIZE in prj.conf) -
	 * 4MHz's own raw throughput ceiling (~500KB/s best-case, worse in
	 * practice with per-command overhead) was the next suspect. This is
	 * a real, independent SPI transaction config specific to this node -
	 * not shared with the display's own (still-4MHz) spi-max-frequency,
	 * so this doesn't touch the display's timing at all. 16MHz leaves
	 * real margin under the SD-over-SPI standard-speed ceiling (25MHz)
	 * rather than jumping straight to it, given the bus/traces
	 * themselves have never been verified above 4MHz for either
	 * peripheral sharing them - the driver itself still negotiates up
	 * from 400kHz during card init regardless of this ceiling. Needs
	 * on-hardware verification (no read/write/CRC errors, and does it
	 * actually fix the slow-listing symptom) - raise further, or back
	 * off, based on that.
	 */
	sdhc0: sdhc@1 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <1>;
		status = "okay";
		spi-max-frequency = <16000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * No bootloader yet (flashed directly over SWD per the
		 * firmware architecture decision in .claude/CLAUDE.md), so
		 * the app image starts at 0x0. Still named slot0/image-0
		 * so adding MCUboot later (for OTA/DFU) is a partition
		 * resize, not a rename.
		 */
		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x00000000 DT_SIZE_K(976)>;
		};

		/* Zephyr settings subsystem (NVS backend): BLE bonding keys.
		 * Separate from storage_partition because settings and
		 * fuel_gauge.c's raw NVS use would otherwise fight over the
		 * same sectors. Carved out of the app image area rather than
		 * out of storage_partition: shrinking that one made the fuel
		 * gauge's existing NVS state fail to mount.
		 */
		settings_partition: partition@f4000 {
			label = "settings";
			reg = <0x000f4000 DT_SIZE_K(16)>;
		};

		/* Fuel gauge learned parameters (raw NVS, fuel_gauge.c). */
		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 DT_SIZE_K(32)>;
		};
	};
};

/*
 * Pins not yet wired to a devicetree node - each belongs to a driver
 * that hasn't been added to the board file yet:
 *
 *   P0.12  SD card detect        - card-detect switch
 *   P0.17  USB detect            - VBUS sense, separate from the native USBD peripheral
 *   P0.13  fuel gauge alert      - MAX17055 alert-gpios
 *   P1.00  charger power-good    - BQ25170 PG output
 *
 * P0.03 (charger status) is wired above (zephyr,user) - see charger.c.
 *
 * P0.15, P0.20, P0.22, P0.04, P0.07, P1.02, P1.04, P1.06, P1.10 are NC
 * per the schematic and intentionally left out.
 */
